<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:overScrollMode="never" />

    <!-- Ecran de chargement natif : masque le WebView pendant l'analyse des
         gros fichiers JS (m1prime.js/m2body.js/langues) et le premier rendu,
         dont la duree varie selon l'appareil. Cliquable pour bloquer tout
         toucher vers le WebView tant qu'il est visible. Masque par
         MainActivity.hideSplash() une fois onPageFinished declenche. -->
    <LinearLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/splash_logo"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/splashBasmala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/splash_basmala"
            android:textColor="#DFCDB1"
            android:textSize="20sp" />

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp">

            <net.tawkit.mobile.CircularProgressView
                android:id="@+id/splashProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/splashProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0%"
                android:textColor="#DFCDB1"
                android:textSize="11sp" />

        </FrameLayout>

    </LinearLayout>

    <!-- Ecran de verrouillage Tawkit (telephone uniquement, cf. LockScreenPrefs/
         LockScreenWatcherService/MainActivity.maybeActivateLockScreenGuard) :
         copie conforme de la page principale (le MEME WebView, pas une copie
         separee), avec une couverture totalement transparente par-dessus qui
         capte tous les touchers (meme "clickable + focusable" trick que
         splashOverlay ci-dessus, invisible ici au lieu de noire) : seul un
         glissement vers le haut est reconnu (MainActivity), qui declenche
         KeyguardManager.requestDismissKeyguard(). Masquee par defaut. -->
    <FrameLayout
        android:id="@+id/lockScreenGuardOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/lockScreenGuardHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:text="⌃ اسحب للأعلى لفتح القفل"
            android:textColor="#C8C8C8"
            android:textSize="13sp" />

    </FrameLayout>

</FrameLayout>
